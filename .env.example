# Telegram bot token from @BotFather (/newbot). Required for the bot and for Telegram login.
BOT_TOKEN=123456789:ABCdefYourTokenFromBotFather

# Long random string that signs player sessions. Generate one: openssl rand -hex 32
SESSION_SECRET=

# Optional: public https URL of the Mini App. Leave empty and `npm run dev:telegram` opens a cloudflared tunnel.
WEBAPP_URL=

# Optional: PostgreSQL (e.g. free Neon). Leave empty to use a local SQLite file.
DATABASE_URL=

# Optional
DB_PATH=underworld.db
PORT=3000
